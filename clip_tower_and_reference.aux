\newlabel{tab:why}{{1}{2}{Only Cloc and Corient consume a text anchor}{table.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}Result: CLIP text tower vs.\ LLaMA anchor}{2}{section.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Both anchor arms (dd256, $n{=}1300$). $G_\mu $ = location gap; $q_4$ = top-4 subspace overlap (where orientation concentrates) vs.\ the named text subspace, random chance $\approx 0.001$. Corient--LLaMA rotates toward LLaMA ($0.140$); Corient--CLIP does \emph  {not} ($0.020$) but rotates toward CLIP ($\mathbf  {0.086}\!\approx \!87\times $ chance); Cloc (distance) stays near chance. CLIPScore SE $\approx 0.003$.}}{2}{table.2}\protected@file@percent }
\newlabel{tab:anchor}{{2}{2}{Both anchor arms (dd256, $n{=}1300$). $G_\mu $ = location gap; $q_4$ = top-4 subspace overlap (where orientation concentrates) vs.\ the named text subspace, random chance $\approx 0.001$. Corient--LLaMA rotates toward LLaMA ($0.140$); Corient--CLIP does \emph {not} ($0.020$) but rotates toward CLIP ($\mathbf {0.086}\!\approx \!87\times $ chance); Cloc (distance) stays near chance. CLIPScore SE $\approx 0.003$}{table.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {6}Reference: LLaVA-1.5-7B (ceiling)}{3}{section.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces LLaVA-1.5-7B, run at inference only (we do not train it). Same CLIP family and MLP connector as our model, but every differing axis favours it and is \emph  {fully optimised}: $336$\,px / $576$ tokens (vs.\ our $224$ / $257$), a Vicuna instruction-tuned LLM (vs.\ base LLaMA-2), and full $\sim $1.2\,M-sample training with the LLM fine-tuned (vs.\ our $450$-step LoRA).}}{3}{figure.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces LLaVA-1.5's two-stage training (full recipe, $\sim $1.2\,M samples), for contrast with our 450-step budget. Stage 1 aligns the connector on 558K image--captions (LLM frozen); Stage 2 instruction-tunes on the 665K mixture, fine-tuning \emph  {both} the connector and the Vicuna LLM. Objective is autoregressive CE only---no geometry or contrastive term.}}{3}{figure.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces One diagnostic model per gap axis --- with vs.\ without the CLIP text tower for the two text-consuming axes (location, orientation) --- and the ceiling (dd256, $n{=}1300$). Scale and shape use image-side pins (no text anchor), so a single row each. Best \emph  {diagnostic} value per column in \textbf  {bold}; ceiling shaded.}}{4}{table.3}\protected@file@percent }
\newlabel{tab:ref}{{3}{4}{One diagnostic model per gap axis --- with vs.\ without the CLIP text tower for the two text-consuming axes (location, orientation) --- and the ceiling (dd256, $n{=}1300$). Scale and shape use image-side pins (no text anchor), so a single row each. Best \emph {diagnostic} value per column in \textbf {bold}; ceiling shaded}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Our best model (Clocorient, a location$+$orientation closure) closes a consistent $\sim $1/4 of the baseline$\to $ceiling gap (CLIP $\sim $28\%, CHAIR$_i$ $\sim $26\%, recall $\sim $25\%), in the same direction full training goes---but a large gap remains, by design. Our checkpoints are single-task diagnostic instruments; their value is the causal attribution of grounding to a geometric axis, which a black-box ceiling cannot provide.}}{4}{figure.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces LLaVA-1.5's own connector-output gap ($n{=}1300$). The scale-normalised $G_\mu /\!\sqrt  {\operatorname  {tr}\Sigma _x}$ is the space-comparable location read; diagnostic reference: \emph  {open} $\approx 2.7$ (C3pinr), \emph  {closed} $\approx 0.45$ (Cloc). Orientation is reported against its random baseline (in parentheses).}}{5}{table.4}\protected@file@percent }
\newlabel{tab:llavageo}{{4}{5}{LLaVA-1.5's own connector-output gap ($n{=}1300$). The scale-normalised $G_\mu /\!\sqrt {\operatorname {tr}\Sigma _x}$ is the space-comparable location read; diagnostic reference: \emph {open} $\approx 2.7$ (C3pinr), \emph {closed} $\approx 0.45$ (Cloc). Orientation is reported against its random baseline (in parentheses)}{table.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7}Why the doses are fixed, not searched (Optuna)}{6}{section.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The Optuna loop we cannot afford. Each trial is a full train$+$evaluate cycle ($\sim $1 GPU-day). The training loss does not predict grounding (our decoupling finding), so a loss-pruner is unreliable and a grounding-probe pruner saves only $\sim $2$\times $; with \texttt  {QOS=1} forcing serial execution on one GPU, a 50--100-trial study still runs into $\sim $2 months.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:optuna}{{5}{6}{The Optuna loop we cannot afford. Each trial is a full train$+$evaluate cycle ($\sim $1 GPU-day). The training loss does not predict grounding (our decoupling finding), so a loss-pruner is unreliable and a grounding-probe pruner saves only $\sim $2$\times $; with \texttt {QOS=1} forcing serial execution on one GPU, a 50--100-trial study still runs into $\sim $2 months}{figure.5}{}}
